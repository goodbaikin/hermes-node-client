# Hermes Node Client Configuration
# Copy this file to .env and fill in your values

# Node identification
HERMES_NODE_ID=dev-win01

# Gateway or API Server WebSocket URL
HERMES_GATEWAY_URL=ws://localhost:8642/ws
# HERMES_API_SERVER_URL=ws://api-server:8642/ws

# Authentication token
HERMES_NODE_TOKEN=dev-token-change-me
